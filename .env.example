# ----------------------------------------------------
# DATABASE & CACHE
# ----------------------------------------------------
DATABASE_URL="postgresql://optimal_user:optimal_password123!@localhost:5432/optimal_remittance?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ----------------------------------------------------
# BACKEND API CONFIGURATION
# ----------------------------------------------------
PORT=4000
NODE_ENV="development"
JWT_SECRET="REPLACE_WITH_A_64_CHARACTER_RANDOM_SECRET_FROM_YOUR_SECRET_MANAGER"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_64_CHARACTER_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="30d"
DATA_ENCRYPTION_KEY="REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY"
CORS_ORIGINS="http://localhost:3000"

# ----------------------------------------------------
# PASSRELLES DE PAIEMENT : AFRIQUE CENTRALE (COLLECTE)
# ----------------------------------------------------
# Gabon (Airtel Money)
AIRTEL_GABON_CLIENT_ID="mock_airtel_client_id"
AIRTEL_GABON_CLIENT_SECRET="mock_airtel_client_secret"
AIRTEL_GABON_MERCHANT_PIN="1234"
AIRTEL_GABON_WEBHOOK_SECRET="whsec_airtel_gabon_123"

# Cameroun & RCA (Orange Money)
ORANGE_MONEY_CLIENT_ID="mock_orange_client_id"
ORANGE_MONEY_CLIENT_SECRET="mock_orange_client_secret"
ORANGE_MONEY_MERCHANT_KEY="mock_orange_key"
ORANGE_MONEY_WEBHOOK_SECRET="whsec_orange_money_123"

# Cameroun (MTN MoMo)
MTN_MOMO_API_KEY="mock_mtn_api_key"
MTN_MOMO_USER_ID="mock_mtn_user_id"
MTN_MOMO_SUBSCRIPTION_KEY="mock_mtn_sub_key"
MTN_MOMO_WEBHOOK_SECRET="whsec_mtn_momo_123"

# RDC (Airtel Money / Orange Money RDC)
RDC_AIRTEL_CLIENT_ID="mock_rdc_airtel_id"
RDC_AIRTEL_CLIENT_SECRET="mock_rdc_airtel_secret"

# ----------------------------------------------------
# PASSRELLES DE DÉCAISSEMENT : MAROC (PAYOUT)
# ----------------------------------------------------
# ChariBaaS (Principal)
CHARI_BAAS_API_URL="https://api.baas.ma/v1"
CHARI_BAAS_API_KEY="mock_chari_api_key"
CHARI_BAAS_WALLET_ID="mock_chari_wallet_mad_1020"
CHARI_BAAS_WEBHOOK_SECRET="whsec_chari_baas_123"

# Aslan (Secondaire / Backup)
ASLAN_API_URL="https://api.aslan.ma/v1"
ASLAN_API_KEY="mock_aslan_api_key"
ASLAN_WEBHOOK_SECRET="whsec_aslan_123"

# ----------------------------------------------------
# SERVICES COMPLÉMENTAIRES (KYC, S3, NOTIFICATIONS)
# ----------------------------------------------------
AWS_ACCESS_KEY_ID="mock_aws_key"
AWS_SECRET_ACCESS_KEY="mock_aws_secret"
AWS_REGION="eu-west-3"
AWS_S3_BUCKET_KYC="optimal-kyc-documents"

# Resend / Emails
RESEND_API_KEY="re_mock_api_key"
EMAIL_FROM="noreply@optimal-transfer.com"

# SMS / OTP (Twilio ou Infobip)
TWILIO_ACCOUNT_SID="mock_twilio_sid"
TWILIO_AUTH_TOKEN="mock_twilio_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Expo Push Notifications
EXPO_ACCESS_TOKEN="mock_expo_access_token"
